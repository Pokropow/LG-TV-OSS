+++ b/linux-and-kdriver_okapi-3/linux-rockhopper/arch/arm64/configs/lg1k_defconfig
@@ -27,6 +27,13 @@ CONFIG_NAMESPACES=y
 # CONFIG_IPC_NS is not set
 # CONFIG_NET_NS is not set
 CONFIG_CHECKPOINT_RESTORE=y
+CONFIG_BLK_DEV_INITRD=y
+CONFIG_RD_GZIP=y
+CONFIG_FRAMEBUFFER_CONSOLE=y
+CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
+CONFIG_FONTS=y
+CONFIG_FONT_8x16=y
+CONFIG_FONT_TER16x32=y
 CONFIG_EXPERT=y
 CONFIG_SYSCTL_SYSCALL=y
 CONFIG_BPF_SYSCALL=y
@@ -128,8 +135,17 @@ CONFIG_VLAN_8021Q=y
 CONFIG_VLAN_8021Q_GVRP=y
 CONFIG_NETLINK_DIAG=y
 CONFIG_BT=y
-# CONFIG_BT_BREDR is not set
-# CONFIG_BT_LE is not set
+# btusb + the MediaTek protocol: the TV has an LG-rebadged MediaTek combo chip
+# on an internal USB port. MTK defaults to n.
+CONFIG_BT_HCIBTUSB=y
+CONFIG_BT_HCIBTUSB_MTK=y
+# Classic Bluetooth. LG disables it -- a TV only ever talks to its own remote --
+# but BT_HIDP depends on it, and without HIDP a classic keyboard pairs and then
+# drops the link because there is no transport for its HID channel.
+CONFIG_BT_BREDR=y
+CONFIG_BT_HIDP=y
+# LE is what the Magic Remote uses (BLE HID). LG ships this disabled.
+CONFIG_BT_LE=y
 # CONFIG_BT_DEBUGFS is not set
 CONFIG_WIRELESS_EXT=y
 CONFIG_WEXT_PRIV=y
