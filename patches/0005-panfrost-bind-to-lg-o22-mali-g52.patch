+/*
+ * Look an interrupt up by name, tolerating the capitalisation used by ARM's
+ * own kbase device trees. Panfrost's bindings say "job"/"mmu"/"gpu", but
+ * vendor DTs written against kbase (LG o22 among them) spell them
+ * "JOB"/"MMU"/"GPU", and platform_get_irq_byname() is case sensitive.
+ * Falls back to the positional lookup, whose order is the same either way.
+ */
+static inline int panfrost_get_irq(struct platform_device *pdev,
+				   const char *lower, const char *upper,
+				   unsigned int index)
+{
+	int irq;
+
+	irq = platform_get_irq_byname(pdev, lower);
+	if (irq > 0)
+		return irq;
+
+	irq = platform_get_irq_byname(pdev, upper);
+	if (irq > 0)
+		return irq;
+
+	return platform_get_irq(pdev, index);
+}
+
 #endif
